# Copie este arquivo para ".env" e ajuste. Todas as opções são opcionais.

# Porta e endereço do servidor
PORT=3000
HOST=0.0.0.0

# Onde ficam os dados (banco, comprovantes, backups). Em servidor, use um disco persistente.
# DATA_DIR=/var/lib/medidores
# DB_FILE=/var/lib/medidores/medidores.db
# BACKUP_DIR=/var/lib/medidores/backups
BACKUP_KEEP=30

# Primeiro administrador (usado só quando o banco está vazio).
# Sem ADMIN_PASSWORD, uma senha aleatória é gerada e mostrada no terminal.
ADMIN_EMAIL=admin@admin.com
# ADMIN_PASSWORD=troque-esta-senha

# Publicação na internet (atrás de Nginx/Caddy com HTTPS):
# TRUST_PROXY=1
# COOKIE_SECURE=true

TZ=America/Sao_Paulo
