# Copie este arquivo para ".env" e ajuste. Todas as opções são opcionais.

# Porta e endereço do servidor
PORT=3000
HOST=0.0.0.0

# Onde ficam os dados (banco, comprovantes, backups). Em servidor, use um disco persistente.
# DATA_DIR=/var/lib/medidores
# DB_FILE=/var/lib/medidores/medidores.db
# BACKUP_DIR=/var/lib/medidores/backups
BACKUP_KEEP=30

# Primeiro administrador (usado só quando o banco está vazio).
# Sem ADMIN_PASSWORD, uma senha aleatória é gerada e mostrada no terminal.
ADMIN_EMAIL=admin@admin.com
# ADMIN_PASSWORD=troque-esta-senha

# Publicação na internet (Render ou atrás de Nginx/Caddy com HTTPS).
# Com NODE_ENV=production o sistema NÃO inicia sem TRUST_PROXY, COOKIE_SECURE=true e DATA_DIR.
# NODE_ENV=production
# TRUST_PROXY=1
# COOKIE_SECURE=true

# Backup externo no Cloudflare R2 (passo a passo em PUBLICACAO.md).
# Preencha as 4 variáveis ou nenhuma.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# BACKUP_REMOTE_KEEP=90
# BACKUP_REMOTE_PREFIX=medidores

# Restauração: defina, reinicie uma vez e depois remova (aplicada uma única vez).
# Aceita r2:latest, r2:<nome-do-backup> ou o caminho de um arquivo .db/.db.gz.
# RESTORE_FROM=r2:latest

# Somente no serviço de demonstração/ensaio: recria dados fictícios a cada início.
# Nunca use no sistema oficial.
# DEMO_ON_START=true

TZ=America/Sao_Paulo
